msgstr "Уведоми всички на линия, които виждат този канал"

#: src/MentionSuggester.cpp
msgid "Role"
msgstr "Роля"

#: src/MessageSender.cpp
msgid "Wait for the file being sent to finish."
msgstr "Изчакай файлът да се изпрати."

#: src/MessageSender.cpp
msgid "You can't attach files in this channel."
msgstr "Не можеш да прикачваш файлове в този канал."

#: src/MessageSender.cpp
msgid "%1 is too large to send."
msgstr "%1 е твърде голям за изпращане."

#: src/MessageSender.cpp
msgid "%1 could not be read."
msgstr "%1 не можа да бъде прочетен."

#: src/MessageSender.cpp
msgid "%1 could not be sent (error %2)."
msgstr "%1 не можа да бъде изпратен (грешка %2)."

#: src/PasswordLogin.cpp
msgid "Enter your email or phone number and your password."
msgstr "Въведи имейла или телефонния си номер и паролата си."

#: src/PasswordLogin.cpp
msgid ""
"This account only has a security key for two-factor authentication, which "
"Disports can't use. Sign in with the QR code instead."
msgstr ""
"Този профил използва само ключ за сигурност за двуфакторно удостоверяване, "
"който Disports не може да използва. Влез с QR кода."

#: src/PasswordLogin.cpp
msgid "A code was sent to %1."
msgstr "Изпратен е код до %1."

#: src/PasswordLogin.cpp
msgid "A code was sent to your phone."
msgstr "Изпратен е код до телефона ти."

#: src/PasswordLogin.cpp
msgid "Enter the code."
msgstr "Въведи кода."

#: src/PasswordLogin.cpp
msgid "Enter a 6-digit code, or an 8-character backup code."
msgstr "Въведи 6-цифрен код или резервен код от 8 знака."

#: src/PasswordLogin.cpp
msgid "Enter the 6-digit code."
msgstr "Въведи 6-цифрения код."

#: src/PasswordLogin.cpp
msgid "Signing in took too long. Please start again."
msgstr "Входът отне твърде дълго. Моля, започни отначало."

#: src/PasswordLogin.cpp
msgid "That code isn't right. Check it and try again."
msgstr "Кодът не е правилен. Провери го и опитай отново."

#: src/PasswordLogin.cpp
msgid "Discord didn't send a sign-in token. Please try again."
msgstr "Discord не изпрати ключ за вход. Моля, опитай отново."

#: src/PasswordLogin.cpp
msgid ""
"Discord asks you to change your password. You can do that on discord.com."
msgstr ""
"Discord иска да смениш паролата си. Можеш да го направиш на discord.com."

#: src/PasswordLogin.cpp
msgid "Couldn't reach Discord. Check your internet connection and try again."
msgstr "Няма връзка с Discord. Провери интернет връзката си и опитай отново."

#: src/PasswordLogin.cpp
msgid ""
"Discord asked for a kind of captcha Disports can't show. Sign in with the QR "
"code instead."
msgstr ""
"Discord поиска вид проверка дали си човек, която Disports не може да покаже. "
"Влез с QR кода."

#: src/PasswordLogin.cpp
msgid "Discord needs the captcha solved before you can sign in."
msgstr "Трябва да минеш проверката дали си човек, преди да влезеш."

#: src/PasswordLogin.cpp
msgid "Too many attempts. Wait %1 s and try again."
msgstr "Твърде много опити. Изчакай %1 сек. и опитай отново."

#: src/PasswordLogin.cpp
msgid ""
"Discord has suspended this account. See discord.com to find out why and to "
"appeal."
msgstr ""
"Discord е спрял този профил. Виж discord.com, за да разбереш защо и да "
"обжалваш."

#: src/PasswordLogin.cpp
msgid "Discord is having trouble right now. Try again in a few minutes."
msgstr "Discord има проблеми в момента. Опитай отново след няколко минути."

#: src/PasswordLogin.cpp
msgid ""
"This account is disabled or scheduled for deletion. Restore it in the "
"official Discord app first."
msgstr ""
"Този профил е деактивиран или насрочен за изтриване. Първо го възстанови в "
"официалното приложение на Discord."

#: src/PasswordLogin.cpp
msgid ""
"Discord sent a code to your phone to confirm this new sign-in. Disports "
"can't take that code yet: sign in with your email address or the QR code "
"instead."
msgstr ""
"Discord изпрати код на телефона ти, за да потвърди този нов вход. Disports "
"все още не може да приеме този код: влез с имейла си или с QR кода."

#: src/PasswordLogin.cpp
msgid "The email, phone number or password isn't right."
msgstr "Имейлът, телефонният номер или паролата не са правилни."

#: src/PasswordLogin.cpp
msgid ""
"Discord sent you an email to confirm this new sign-in. Open it, confirm, "
"then sign in here again."
msgstr ""
"Discord ти изпрати имейл, за да потвърди този нов вход. Отвори го, потвърди "
"и после влез отново тук."

#: src/PasswordLogin.cpp
msgid "Discord said: %1"
msgstr "Discord каза: %1"

#: src/PasswordLogin.cpp
msgid "Signing in didn't work (error %1). Please try again."
msgstr "Входът не успя (грешка %1). Моля, опитай отново."

#: src/RemoteAuth.cpp
msgid "Preparing QR code..."
msgstr "Подготвяне на QR кода..."

#: src/RemoteAuth.cpp
msgid "QR login only works with Discord's own servers."
msgstr "Входът с QR код работи само със сървърите на Discord."

#: src/RemoteAuth.cpp
msgid "Discord QR login failed. Tap refresh to try again."
msgstr "Входът с QR код не успя. Опресни кода, за да опиташ отново."

#: src/RemoteAuth.cpp
msgid ""
"Couldn't reach Discord. Check your internet connection, then tap refresh."
msgstr "Няма връзка с Discord. Провери интернет връзката си и опресни QR кода."

#: src/RemoteAuth.cpp
msgid "The QR code expired. Tap refresh to get a new one."
msgstr "QR кодът изтече. Опресни го, за да получиш нов."

#: src/RemoteAuth.cpp
msgid "Open Discord on your Android or iOS device and scan to sign in."
msgstr ""
"Отвори Discord на устройството си с Android или iOS и сканирай кода, за да "
"влезеш."

#: src/RemoteAuth.cpp
msgid "Confirm the login on your phone."
msgstr "Потвърди входа на телефона си."

#: src/RemoteAuth.cpp
msgid "QR login was canceled on your phone."
msgstr "Входът с QR код беше отказан от телефона ти."

#: src/RemoteAuth.cpp
msgid "Signing in..."
msgstr "Влизане..."

#: src/RemoteAuth.cpp
msgid "Signed in."
msgstr "Влизането е успешно."

#: src/Session.cpp
msgid ""
"Discord didn't accept this token. Make sure you copied all of it, and that "
"it's still valid (signing out of Discord makes it invalid)."
msgstr ""
"Discord не прие този ключ. Провери дали си го копирал целия и дали още е "
"валиден (излизането от Discord го прави невалиден)."

#: src/Session.cpp
msgid "Your session has expired. Please sign in again."
msgstr "Сесията ти изтече. Моля, влез отново."

#: src/Session.cpp
msgid "You don't have access to this channel."
msgstr "Нямаш достъп до този канал."

#: src/Session.cpp
msgid "The message could not be edited."
msgstr "Съобщението не можа да бъде редактирано."

#: src/TypingIndicator.cpp
msgid "Someone"
msgstr "Някой"

#: src/TypingIndicator.cpp
msgid "%1 is typing..."
msgstr "%1 пише..."

#: src/TypingIndicator.cpp
msgid "%1 and %2 are typing..."
msgstr "%1 и %2 пишат..."

#: src/TypingIndicator.cpp
msgid "Several people are typing..."
msgstr "Няколко души пишат..."

#: src/voice/CallManager.cpp
msgid "You left the call: no one else joined for 3 minutes."
msgstr "Напусна разговора: никой друг не се включи за 3 минути."

#: src/voice/CallManager.cpp
msgid "Incoming call"
msgstr "Входящо обаждане"

#: src/voice/CallManager.cpp
msgid "Waiting for others..."
msgstr "Изчакване на другите..."

#: src/voice/CallManager.cpp
msgid "The call ended: the connection to Discord was lost."
msgstr "Разговорът приключи: връзката с Discord беше загубена."

#: src/voice/CallManager.cpp
msgid "You don't have permission to speak in this channel."
msgstr "Нямаш право да говориш в този канал."

#: src/voice/CallManager.cpp
msgid "The call ended: %1"
msgstr "Разговорът приключи: %1"
