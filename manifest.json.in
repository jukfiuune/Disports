{
    "name": "disports.jukfiuu",
    "description": "A Discord client for Ubuntu Touch",
    "architecture": "$ENV{ARCH}",
    "title": "Disports",
    "icon": "assets/logo.svg",
    "hooks": {
        "disports": {
            "apparmor": "disports.apparmor",
            "desktop":  "disports.desktop",
            "urls":     "disports.dispatcher"
        },
        "push": {
            "apparmor": "push.apparmor",
            "push-helper": "push.json"
        }
    },
    "version": "0.8.5",
    "maintainer": "Martin Filipov <jukfiuune@gmail.com>",
    "framework" : "$ENV{CLICK_FRAMEWORK}"
}
